# Postgres connection string (Replit/Neon/any Postgres 14+)
DATABASE_URL=postgres://user:pass@host:5432/astropilot
# Long random string used to sign session cookies
SESSION_SECRET=change-me
# Port the server listens on (Replit uses 5000)
PORT=5000
# Optional: Google sign-in
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional (Replit object storage for observation photos), e.g. /replit-objstore-xxxx/.private
PRIVATE_OBJECT_DIR=
